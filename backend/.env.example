# Use a local MongoDB or paste your Atlas connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=fieldnotes
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# From Firebase Console > Project settings > Service accounts.
# Keep this file private. NEVER prefix these variables with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional for local Firebase Authentication Emulator ONLY:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-fieldnotes
