# Firebase Console > Project settings > General > Your apps > Web app config.
# These identify your Firebase web app; admin credentials belong ONLY in backend/.env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Leave empty to use the Vite proxy or the same-origin production API.
VITE_API_URL=
# Optional for local Firebase Authentication Emulator ONLY:
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
